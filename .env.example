# ---------------------------------------------------------------
# Required
# ---------------------------------------------------------------
# Owner login for /admin. At least 8 characters. Do not wrap it in quotes in a hosting dashboard.
ADMIN_PASSWORD=change-me-to-something-long

# ---------------------------------------------------------------
# Added for you when you connect storage on Vercel (do not type these in)
# ---------------------------------------------------------------
# DATABASE_URL / POSTGRES_URL   -> from Vercel Storage > Neon (Postgres)
# BLOB_READ_WRITE_TOKEN         -> from Vercel Storage > Blob (item photos)

# ---------------------------------------------------------------
# Optional
# ---------------------------------------------------------------
# Keeps the owner signed in across restarts. If left out, it is derived from ADMIN_PASSWORD.
# SESSION_SECRET=any-long-random-string
# Your live address, used in search-engine data. Example: https://thevintagestore.example
# PUBLIC_URL=
# Email each new request to the owner as well as saving it.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=shop@example.com
# MAIL_TO=owner@example.com

# ---------------------------------------------------------------
# Only for running on your own computer or a server with a disk (not Vercel)
# ---------------------------------------------------------------
# PORT=3000
# TRUST_PROXY=1
# DATA_DIR=/var/data
# UPLOAD_DIR=/var/data/uploads
# DATABASE_URL=postgresql://user:pass@host/db   (otherwise a local SQLite file is used)
