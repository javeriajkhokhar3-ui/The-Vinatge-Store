# Copy to .env or set these in your host's dashboard.
PORT=3000
NODE_ENV=production

# Owner login for /admin. Choose something long. If unset, a random password is printed at startup.
ADMIN_PASSWORD=change-me-to-something-long
# Any long random string. Keeps the owner signed in across restarts.
SESSION_SECRET=change-me-too

# Set to 1 when hosted behind a proxy (Render, Railway, Fly, Heroku, nginx).
TRUST_PROXY=1
# Your live address, used in search-engine data. Example: https://thevintagestore.example
PUBLIC_URL=

# Where the database and uploaded photos live. Point these at a persistent disk in production.
# DATA_DIR=/var/data
# UPLOAD_DIR=/var/data/uploads

# Optional: also email each new request to the owner.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=shop@example.com
# MAIL_TO=owner@example.com
